// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum CallOutcome {
  BOOKED
  ENQUIRY
  FOLLOW_UP_NEEDED
  INCOMPLETE
  FAILED
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ScheduleExceptionType {
  OFF
  CUSTOM
}

model Doctor {
  id         String  @id @default(cuid())
  name       String
  department String
  speciality String
  isActive   Boolean @default(true)

  appointments Appointment[]
  schedules    DoctorSchedule[]
  exceptions   ScheduleException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorSchedule {
  id        String    @id @default(cuid())
  doctorId  String
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String // "HH:mm" wall-clock time
  endTime   String // "HH:mm" wall-clock time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
}

model Patient {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls        Call[]
  appointments Appointment[]
  extractions  CallExtraction[]

  @@index([phone])
}

model Appointment {
  id           String            @id @default(cuid())
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientId    String?
  patient      Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  callId       String?           @unique
  call         Call?             @relation(fields: [callId], references: [id], onDelete: SetNull)
  patientName  String
  patientEmail String?
  patientPhone String?
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(BOOKED)
  reason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, startTime])
  @@index([patientId])
}

model ScheduleException {
  id        String                @id @default(cuid())
  doctorId  String
  doctor    Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime              @db.Date
  type      ScheduleExceptionType // OFF or CUSTOM
  startTime String?
  endTime   String?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, date])
}

model Document {
  id         String   @id @default(cuid())
  fileName   String
  fileType   String // "pdf" | "docx" | "txt" | "md"
  fileSize   Int
  content    String // full extracted text
  chunkCount Int      @default(0)
  status     String   @default("READY") // PROCESSING | READY | FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Call {
  id           String       @id @default(cuid())
  callId       String       @unique // the socket session uuid
  startedAt    DateTime
  endedAt      DateTime
  durationSec  Int
  patientName  String?
  patientPhone String?
  userTurns    Int          @default(0)
  transcript   Json         // [{ role, text, at, text_bn?, text_en? }]
  audioKey     String?      // S3 object key for the combined recording
  recordingUrl String?      // Playback URL
  status       String       @default("COMPLETED") // COMPLETED | NO_AUDIO | FAILED
  outcome      CallOutcome  @default(INCOMPLETE)

  patientId   String?
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  extraction  CallExtraction?
  appointment Appointment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([patientId])
  @@index([outcome])
}

model CallExtraction {
  id                String      @id @default(cuid())
  callId            String      @unique
  call              Call        @relation(fields: [callId], references: [id], onDelete: Cascade)
  patientId         String?
  patient           Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName       String?
  phone             String?
  reasonForVisit    String?
  preferredDateTime String?
  intent            String?
  outcome           CallOutcome @default(INCOMPLETE)
  notes             String?
  validationStatus  String      @default("VALID") // VALID | INVALID_PHONE | NEEDS_REVIEW

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}
