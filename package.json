{
  "name": "byte-care-ai",
  "private": true,
  "scripts": {
    "build": "pnpm --filter=@repo/shared build && pnpm --filter=api build && pnpm --filter=web build",
    "build:web": "pnpm --filter=@repo/shared build && pnpm --filter=web build",
    "build:api": "pnpm --filter=@repo/shared build && pnpm --filter=api build",
    "start": "pnpm --filter=api start",
    "dev": "pnpm --parallel --filter=web --filter=api dev",
    "dev:web": "pnpm --filter=web dev",
    "dev:api": "pnpm --filter=api dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
